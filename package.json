{
  "name": "oj-branding-preset",
  "version": "1.0.0",
  "description": "Shared brand color/design tokens (CSS variables + JSON) across MERN and Laravel projects",
  "main": "index.js",
  "files": [
    "index.js",
    "css",
    "scripts",
    "tokens",
    "ui",
    "assets"
  ],
  "exports": {
    ".": "./index.js",
    "./css/*": "./css/*",
    "./tokens/*": "./tokens/*",
    "./ui/*": "./ui/*",
    "./assets/*": "./assets/*",
    "./scripts/*": "./scripts/*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenoxxxx/OJ-branding-preset.git"
  },
  "keywords": ["design-tokens", "theme", "css-variables", "tailwind"],
  "license": "MIT"
}