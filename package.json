{
  "name": "oj-branding-preset",
  "version": "1.0.1",
  "description": "Shared brand color/design tokens (CSS variables + JSON) across MERN and Laravel projects",
  "main": "index.js",
  "files": [
    "index.js",
    "css",
    "scripts",
    "tokens",
    "ui",
    "assets"
  ],
  "exports": {
    ".": "./index.js",
